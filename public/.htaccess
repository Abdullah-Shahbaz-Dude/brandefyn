<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Let WordPress handle /blog (admin, wp-json, etc.) - do not send to SPA
  RewriteRule ^blog - [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
