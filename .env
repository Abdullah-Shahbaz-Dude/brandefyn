# Contact form: sign up at https://formspree.io, create a form, then copy your form endpoint here.
VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# WordPress REST API: use proxy in dev (/api/blog), production uses .env.production (/blog/wp-json).
VITE_WP_API_URL=/api/blog

# Reddit Ads conversion pixel ID (from ads.reddit.com → Tools → Conversion tracking). Leave empty to disable.
VITE_REDDIT_PIXEL_ID=a2_icrjq7rid7up
